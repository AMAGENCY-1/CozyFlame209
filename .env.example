# Client portal
# The owner's password key. Create it at /portal/setup (or: npm run portal:hash -- "password").
# Set it in Vercel → Project → Settings → Environment Variables, then redeploy.
PORTAL_PASSWORD_HASH=
# Optional. Defaults to "thecozyflame".
# PORTAL_USERNAME=thecozyflame
# Optional. A random 32+ character string to sign sessions; otherwise derived from the password key.
# PORTAL_SESSION_SECRET=

# Product storage. Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Local only: save products to .data/ instead of Vercel Blob when running `next start`.
# PORTAL_LOCAL_STORE=1
